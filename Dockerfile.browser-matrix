FROM --platform=linux/amd64 denoland/deno:2.9.6

USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg xauth xvfb \
  && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
    | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
  && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" \
    > /etc/apt/sources.list.d/google-chrome.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends google-chrome-stable \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .
RUN chmod +x scripts/with-xvfb.sh \
  && deno cache --lock=deno.lock src/browser_matrix.ts

ENTRYPOINT ["/app/scripts/with-xvfb.sh", "deno", "task", "browser-matrix", "--", "chrome-headed"]
