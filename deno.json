{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.ns", "deno.unstable", "dom", "dom.iterable"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check main.ts src/ scripts/ tests/ web/src/ web/vite.config.ts",
    "test": "deno test",
    "test:unit": "deno test",
    "test:integration": "deno test --env --allow-env --allow-net tests/reconciliation_test.ts",
    "web:dev": "deno run -A npm:vite --config web/vite.config.ts --host 0.0.0.0",
    "web:build": "deno run -A npm:vite build --config web/vite.config.ts",
    "web:preview": "deno run -A npm:vite preview --config web/vite.config.ts --host 0.0.0.0",
    "ci": "deno install --frozen && deno task fmt:check && deno task lint && deno task check && deno task test && deno task web:build",
    "verify": "deno task ci",
    "build": "deno task ci",
    "serve": "deno run --allow-env --allow-net --allow-read main.ts",
    "migrate": "deno run --allow-env --allow-net --allow-read scripts/migrate.ts",
    "browserless:smoke": "deno run --allow-env --allow-net --allow-sys scripts/diagnostics/browserless_smoke.ts",
    "email:configure": "deno run --allow-env --allow-net --allow-read scripts/email_configure.ts",
    "email:test": "deno run --allow-env --allow-net --allow-read scripts/send_test_email.ts"
  },
  "unstable": ["cron"],
  "deploy": {
    "org": "andrewtryder",
    "app": "car-part-watcher",
    "build": "deno task ci",
    "predeploy": "deno task migrate",
    "runtime": { "type": "dynamic", "entrypoint": "main.ts" }
  },
  "imports": {
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@types/react": "npm:@types/react@^19.3.0",
    "@types/react-dom": "npm:@types/react-dom@^19.3.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.1.1",
    "lucide-react": "npm:lucide-react@^1.49.0",
    "react": "npm:react@^19.3.0",
    "react-dom": "npm:react-dom@^19.3.0",
    "react-router-dom": "npm:react-router-dom@^7.18.4",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@^8.3.1"
  }
}
