# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=verify-full

# Browserless remote-CDP configuration (production infrastructure)
BROWSERLESS_API_KEY=
# BROWSERLESS_ENDPOINT=wss://production-sfo.browserless.io
# BROWSERLESS_SESSION_TIMEOUT_MS=60000

# Gmail SMTP delivery (optional; if unset/disabled, LoggingNotifier is used)
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Runtime environment. Deployments should use production; local development may
# use development (the default when unset).
APP_ENV=development

# Browser-native HTTP Basic Auth for the operational web console and its API.
# Authentication defaults to enabled when this variable is unset. Set false
# explicitly to make the console/API public.
CONSOLE_AUTH_ENABLED=true
CONSOLE_USERNAME=
CONSOLE_PASSWORD=

# Application timezone (defaults to America/New_York)
APP_TIMEZONE=America/New_York

# Public application base URL (used for links in email notifications)
APP_BASE_URL=https://car-part-watcher.deno.dev
